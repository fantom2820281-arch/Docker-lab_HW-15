# Образец. Секретов здесь нет.
# Скопируй и заполни:  cp .env.example .env
# Файл .env в git не коммитится (.gitignore). Compose читает его сам.

# --- контейнер MySQL (официальный образ mysql:8, переменные MYSQL_*) ---
# MYSQL_ROOT_PASSWORD  пароль суперпользователя внутри контейнера БД
# MYSQL_DATABASE       имя базы; то же значение уйдёт в приложение как DB_NAME
# MYSQL_USER           пользователь приложения; в FastAPI это DB_USER
# MYSQL_PASSWORD       пароль этого пользователя; в FastAPI это DB_PASSWORD
#
# DB_HOST в compose зашит как имя сервиса `db`, в .env его нет — так и должно быть.

MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=virtd
MYSQL_USER=app
MYSQL_PASSWORD=changeme_app
